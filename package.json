{
	"name": "bpsr-logs",
	"version": "0.1.0",
	"description": "",
	"type": "module",
	"packageManager": "bun@1.3.14",
	"scripts": {
		"build": "bun run --bun vite build",
		"check": "bun run --bun svelte-kit sync && bun run --bun svelte-check --tsconfig ./tsconfig.json && cargo check --manifest-path src-tauri/Cargo.toml",
		"check:watch": "bun run --bun svelte-kit sync && bun run --bun svelte-check --tsconfig ./tsconfig.json --watch",
		"clean": "cargo clean --manifest-path src-tauri/Cargo.toml",
		"dev": "bun run --bun svelte-kit sync && bun run --bun vite dev",
		"format": "prettier --write . && cargo fmt --manifest-path src-tauri/Cargo.toml",
		"format:check": "prettier --check . && cargo fmt --check --manifest-path src-tauri/Cargo.toml",
		"lint": "eslint .",
		"preview": "vite preview",
		"tauri": "tauri",
		"update": "cargo update --manifest-path src-tauri/Cargo.toml",
		"upgrade": "ncu -u && bun install && cargo install cargo-edit && cargo upgrade --incompatible allow --manifest-path src-tauri/Cargo.toml && cargo update --manifest-path src-tauri/Cargo.toml"
	},
	"license": "MIT",
	"dependencies": {
		"@tanstack/table-core": "^8.21.3",
		"@tauri-apps/api": "^2.11.1",
		"@tauri-apps/plugin-autostart": "^2.5.1",
		"@tauri-apps/plugin-clipboard-manager": "^2.3.2",
		"@tauri-apps/plugin-global-shortcut": "^2.3.2",
		"@tauri-apps/plugin-opener": "^2.5.4",
		"@tauri-apps/plugin-os": "^2.3.2",
		"@tauri-apps/plugin-store": "^2.4.4",
		"@tauri-apps/plugin-updater": "^2.10.1",
		"@tauri-store/svelte": "^3.2.1",
		"html2canvas-pro": "^2.3.2",
		"tippy.js": "^6.3.7"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.0",
		"@eslint/js": "^10.0.1",
		"@iconify-json/logos": "^1.2.11",
		"@iconify-json/lucide": "^1.2.120",
		"@iconify/json": "^2.2.507",
		"@internationalized/date": "^3.12.2",
		"@lucide/svelte": "^1.28.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.2",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.3",
		"@tauri-apps/cli": "^2.11.4",
		"@types/node": "^26.1.2",
		"bits-ui": "^2.18.1",
		"clsx": "^2.1.1",
		"eslint": "^10.8.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.22.0",
		"formsnap": "^2.0.1",
		"globals": "^17.8.0",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.56.8",
		"svelte-check": "^4.7.4",
		"svelte-eslint-parser": "^1.8.0",
		"sveltekit-superforms": "^2.30.2",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.3.0",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.65.0",
		"unplugin-icons": "^23.0.1",
		"vite": "^8.2.0"
	}
}
